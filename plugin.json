{
  "name": "office",
  "version": "1.7.0",
  "description": "Presencia en tiempo real de trabajadores en la oficina virtual. Integración con Bitrix24.",
  "author": "VLA Team",
  "vlaMinVersion": "1.1.0",
  "route": "/dashboard/office",
  "icon": "office",
  "adminOnly": false,
  "accessPermissions": [
    "office.view",
    "office.checkin",
    "office.manage"
  ],
  "requires": [
    "bitrix"
  ],
  "permissions": [
    "read:users",
    "read:presence",
    "write:presence",
    "read:checkins",
    "write:checkins",
    "read:absences",
    "write:absences",
    "read:holidays",
    "write:holidays",
    "read:meetings",
    "write:meetings",
    "read:org",
    "write:org"
  ],
  "hooks": {
    "listens": [
      "core.user.created"
    ],
    "emits": [
      "office.user.checked_in",
      "office.user.checked_out",
      "office.user.status_changed",
      "office.user.moved",
      "office.absence.created"
    ]
  }
}
