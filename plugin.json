{
  "name": "office",
  "version": "1.3.0",
  "description": "Presencia en tiempo real de trabajadores en la oficina virtual. Integración con Bitrix24.",
  "author": "VLA Team",
  "vlaMinVersion": "1.1.0",
  "route": "/dashboard/office",
  "icon": "office",
  "adminOnly": false,
  "accessPermissions": ["office.view", "office.checkin", "office.manage"],
  "requires": ["bitrix"],
  "permissions": [
    "read:users",
    "read:presence",
    "write:presence",
    "read:checkins",
    "write:checkins",
    "read:absences",
    "write:absences",
    "read:holidays",
    "write:holidays",
    "read:meetings",
    "write:meetings",
    "read:org",
    "write:org"
  ],
  "settings": {
    "sections": [
      {
        "title": "Dashboard de tiempos",
        "fields": [
          {
            "key": "MAX_OPEN_SESSION_HOURS",
            "type": "number",
            "label": "Cota de una sesión sin marcar salida (horas)",
            "description": "A quien entra de vacaciones con la sesión abierta nadie se la cierra: los crones saltean a los ausentes a propósito. Sin cota, una semana de ausencia reporta 10.080 minutos en oficina. Solo afecta al reporte de tiempos.",
            "default": 12,
            "min": 1,
            "max": 24
          }
        ]
      }
    ]
  },
  "hooks": {
    "listens": ["core.user.created"],
    "emits": [
      "office.user.checked_in",
      "office.user.checked_out",
      "office.user.status_changed",
      "office.user.moved",
      "office.absence.created"
    ]
  }
}
